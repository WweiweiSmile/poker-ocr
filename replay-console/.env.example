# 手牌复跑控制台（独立项目）
# 复制为 .env 后按需修改。进程环境变量优先于本文件。
#
# DB_* 会按顺序从 poker-ocr/.env、../call-back/.env 补齐；也在这里显式覆盖。

# 服务监听。默认只绑本机；对局域网开放时必须设 REPLAY_TOKEN。
REPLAY_HOST=127.0.0.1
REPLAY_PORT=8010
# REPLAY_TOKEN=
# REPLAY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# MySQL（复用 call-back 的实例与 schema）
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=call_game_dev
# DB_PASSWORD=change-me
# DB_NAME=call_game_dev
# REPLAY_SKIP_CALLBACK_ENV=1
# REPLAY_CALLBACK_ENV=/absolute/path/to/call-back/.env

# 只读哪些用户的手牌：0 = 全部（内部单人库）
REPLAY_HAND_USER_ID=0
REPLAY_CONSOLE_USER_ID=0

# worker
REPLAY_WORKER_ENABLED=1
REPLAY_WORKERS=2
REPLAY_TIMEOUT=30
REPLAY_RETRIES=2
REPLAY_RATE_LIMIT=5
REPLAY_MAX_CALLS_PER_JOB=2000
REPLAY_MAX_QUEUE_DEPTH=3
REPLAY_DEFAULT_REPEAT=1
REPLAY_AUTO_MIGRATE=1

# 结果里的 prompt/raw 保留策略
REPLAY_STORE_PROMPTS=1
REPLAY_RETENTION_DAYS=365
