# AI 实时建议（--ai-advice）的模型配置。
# 复制为 .env 后填真 Key：
#
#     cp .env.example .env
#
# 环境变量优先于本文件：已经 export 的同名变量不会被覆盖。
#
# 模型名决定协议：
#   · 名字里带 jev（jev-1.14 / typesafe/jev-1.14）→ JEV decisions 协议，
#     AI_SERVER_BASE_URL 填**完整**的 decisions 地址
#   · 其他 → OpenAI 兼容的 {AI_SERVER_BASE_URL}/chat/completions
#     （DeepSeek、OpenRouter 上的 GPT 等都是这一类）

# ---- JEV（OpenRouter decisions）----
AI_SERVER_API_KEY=
AI_SERVER_BASE_URL=https://openrouter.ai/api/alpha/decisions
AI_SERVER_MODEL=typesafe/jev-1.14

# OpenRouter 的可选排名头
# AI_SERVER_REFERER=https://your-site.example
# AI_SERVER_TITLE=poker-ocr

# ---- 或：OpenRouter /chat/completions（GPT，与 JEV 共用同一个 Key）----
# 与上面的 JEV 段互斥：同一时间只启用一套未注释的 AI_SERVER_*。
# 推理走 OpenRouter 的 {"reasoning": {"enabled": true}}；响应里的
# reasoning_details 会原样保留，多轮续推时回传给模型（见 advice.chat_message）。
# AI_SERVER_API_KEY=sk-or-v1-...
# AI_SERVER_BASE_URL=https://openrouter.ai/api/v1
# AI_SERVER_MODEL=openai/gpt-5.6-luna
# AI_SERVER_REASONING=enabled           # enabled | disabled
# AI_SERVER_TIMEOUT=20                  # 开推理会变慢，实时链路建议 15–30 秒
# 推理模型通常只接受默认 temperature，别设 AI_SERVER_TEMPERATURE。
# 也不建议设 AI_SERVER_MAX_TOKENS：推理 token 同样计入，设小了会被截断。

# ---- 或：OpenAI 兼容 /chat/completions（DeepSeek 等）----
# AI_SERVER_BASE_URL=https://api.deepseek.com
# AI_SERVER_MODEL=deepseek-flash
#
# 采样/思考参数（只对 /chat/completions 生效，JEV 协议忽略）：
# deepseek-flash 默认开启思考（reasoning_effort=high），而思考模式下
# temperature 会被忽略。实时建议推荐关掉思考，让 temperature 生效。
# AI_SERVER_THINKING=disabled          # enabled | disabled（DeepSeek）
# AI_SERVER_REASONING=                 # enabled | disabled（OpenRouter 的 reasoning.enabled）
# AI_SERVER_TEMPERATURE=0.2            # 0–2；思考/推理模式下不生效
# AI_SERVER_MAX_TOKENS=200             # 不设时服务端默认（思考模式 64K）
# AI_SERVER_TOP_P=                     # 0–1；flash 仅思考模式生效（夹到 0.95–1.0）
# AI_SERVER_REASONING_EFFORT=          # none | low | high | max
#
# 若要保留少量推理：THINKING=enabled + REASONING_EFFORT=low + TOP_P=0.95，
# 此时不要依赖 TEMPERATURE。
#
# 单次建议超时（秒）。也可用 --ai-timeout 覆盖；实时链路建议 5–8 秒。
# AI_SERVER_TIMEOUT=8

# 可选：显式指定 .env 路径。默认先找项目根目录，再找启动时的 CWD。
# 指定了却读不到会直接启动失败（不静默退回），避免「配了却没生效」。
# ENV_FILE=/absolute/path/to/.env

# 可选：牌桌动态文件。默认读项目根目录的 .table_dy（不存在 = 按未知对手标准线）。
# TABLE_DY_FILE=/absolute/path/to/.table_dy

# 可选：没读到自己手牌时也写入手牌记录（默认 0 = 跳过换手空档的空记录）。
# 旁观/观察对手时设 1；等价于命令行 --record-without-hero。
# RECORD_WITHOUT_HERO=0

# 可选：对手画像 JSON。默认 data/opponents/profiles.json（本地、不入库）。
# 用 --no-opponent-profile 可关闭；--opponent-db 可覆盖本变量。
# OPPONENT_DB=data/opponents/profiles.json

# ── GTO 近似表（可选）────────────────────────────────────────────
# 默认开启；没有库、多人池、非单加注池、SPR 不在档位内时自动跳过，
# 不往提示词里塞任何 GTO 内容。
# GTO_ENABLED=1
# GTO_TABLE_PATH=gto/data/gto.sqlite
# GTO_SPECS_DIR=gto/specs

# ── 实时牌面范围 + 手牌强度（可选）──────────────────────────────
# 默认开启：每个在局对手用「翻前先验 × 当前街动作 mode」构建范围，
# 再算 behind-now / equity / beaten-by。缺位置或缺动作时自动降级为
# range unknown，不影响主建议链路。
# HAND_VS_RANGES_ENABLED=1
# HAND_VS_RANGES_SAMPLES=2000          # 4 人以上自动降到 1500
# BOARD_RANGE_MIN_WEIGHT=0.30          # 全局覆盖各 mode 的连接度门槛
# HAND_STRENGTH_ENABLED=1              # 牌力解析：把 behind/equity 合成一行结论
# HAND_STRENGTH_THRESHOLDS={"behind_demote":0.35,"ratio_strong":2.0,"ratio_above":1.3,"ratio_neutral":0.85}
