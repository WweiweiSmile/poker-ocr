    {
      "id": "pf.rfi.first_in",
      "version": 1,
      "slot": "intent",
      "street": "preflop",
      "node": "第一个入池",
      "preconditions": [
        {
          "fact": "street",
          "eq": "preflop"
        },
        {
          "fact": "limpers_before",
          "eq": 0
        },
        {
          "fact": "raises_before",
          "eq": 0
        },
        {
          "fact": "hand_in_open_range",
          "eq": true
        },
        {
          "fact": "ante_bb",
          "lte": 0
        },
        {
          "fact": "hero_position",
          "not_in": [
            "SB",
            "BB"
          ]
        }
      ],
      "why": "第一个入池只加注，减少对手并让翻后好判断",
      "action": "raise",
      "size": {
        "table": "rule_params",
        "name": "open_size_bb",
        "unit": "bb",
        "key": "position_group"
      },
      "source": {
        "book": "德州扑克小绿皮书",
        "page": 18,
        "status": "verbatim"
      },
      "confidence": "book",
      "verified": false
    },
    {
