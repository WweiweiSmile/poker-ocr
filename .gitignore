.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.idea/

# 本地配置（含模型 Key）。.env.example 是可提交的模板
.env
.env.*
!.env.example

# 自动点击的按钮坐标（因机器/窗口位置而异，由标定工具生成）
config/clicker_local.json
config/clicker_*.json
!config/clicker.example.json

# 实时识别的运行产物
logs/
images/
*.states.jsonl
hands.json
shots/
frames/

# MediaMTX 自动生成的证书（不要提交私钥）
auto.crt
auto.key
server.crt
server.key
/:memory:.ses
/hands/

# 对手画像（玩家昵称/统计，本地保存，不入库）
data/opponents/

# 已结束手牌的 outbox（等手牌库异步取走）
data/hand_outbox/

# GTO 跑批：本地工具链 / 编译产物 / 原始数据 / 任务清单
.toolchain/
gto/runner/target/
gto/data/
gto/jobs/
