.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.idea/

# 本地配置（含模型 Key）。.env.example 是可提交的模板
.env
.env.*
!.env.example

# 自动点击的按钮坐标（因机器/窗口位置而异，由标定工具生成）
config/clicker_local.json
config/clicker_*.json
!config/clicker.example.json

# 实时识别的运行产物
logs/
images/
*.states.jsonl
shots/
frames/

# MediaMTX 自动生成的证书（不要提交私钥）
auto.crt
auto.key
server.crt
server.key
